{
  "name": "dq9-test-mcp-foundation",
  "version": "0.1.0",
  "description": "One-lane MCP/CDP relay with a frozen Phase-0 local contract.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate:dependencies": "node --input-type=module -e \"import { loadAndValidateLocalDependencies } from './src/services/dependency-validator.mjs'; console.log(JSON.stringify(await loadAndValidateLocalDependencies('./config/local-dependencies.json')));\"",
    "smoke": "node scripts/run-local-smoke.mjs",
    "smoke:browsers": "node scripts/run-multi-browser-smoke.mjs"
  }
}
