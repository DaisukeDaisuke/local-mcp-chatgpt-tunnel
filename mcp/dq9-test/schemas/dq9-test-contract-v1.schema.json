{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/dq9-test-contract-v1.schema.json",
  "title": "DQ9 test Phase-0 contract freeze v1",
  "description": "This portable JSON Schema documents the contract. src/schemas/contract-validator.mjs is the repository-native enforcing validator; it also enforces bounded JSON and prohibited-body rules.",
  "$defs": {
    "common": {
      "type": "object",
      "required": ["schemaVersion", "createdAt", "provenance", "confidence"],
      "properties": {
        "schemaVersion": {"const": "dq9-test-contract-v1"},
        "createdAt": {"type": "string", "format": "date-time"},
        "provenance": {"type": "string"},
        "confidence": {"enum": ["confirmed", "supported", "candidate", "unknown", "rejected"]}
      }
    },
    "nullableString": {"type": ["string", "null"]},
    "nullableInteger": {"type": ["integer", "null"]},
    "nullableHex": {"type": ["string", "null"], "pattern": "^0x[0-9a-f]+$"},
    "envelope": {
      "oneOf": [
        {"type": "object", "required": ["ok", "value"], "properties": {"ok": {"const": true}, "value": {"type": "object"}}},
        {"type": "object", "required": ["ok", "error"], "properties": {"ok": {"const": false}, "error": {"type": "object", "required": ["code", "message", "recoverable", "details"]}}}
      ]
    },
    "run": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["runId", "runtimeId", "runtimeEpoch", "suiteId", "suiteKind", "suiteRef", "requestedConcurrency", "effectiveConcurrency", "stopOnFirstMismatch", "incidentPolicy", "state", "dispatchOpen", "statusVersion", "caseCounts", "incidentIds", "stopTriggerCaseId", "startedAt", "completedAt", "durationMs", "buildId", "baselineId", "staticContractSetId"]}]},
    "workerLane": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["workerId", "laneId", "runtimeEpoch", "state", "health", "recoveryGeneration", "leaseId", "browserPid", "browserStartedAt", "childPid", "cdpEndpointRef", "portLeases", "profileDir", "workDir", "stateNamespace", "baselineSlot", "lastHeartbeatAt", "lastError", "quarantineReason"]}]},
    "case": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["caseId", "runId", "suiteOrdinal", "suiteKind", "inputRef", "inputSha256", "parserProfile", "seed", "initialRngPosition", "expectedRef", "actualRef", "workerId", "leaseId", "attempt", "state", "outcome", "firstMismatchId", "startedAt", "completedAt", "durationMs", "exit"]}]},
    "build": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["buildId", "profile", "configuredAt", "builtAt", "cmakePath", "cmakeVersion", "ninjaVersion", "ninjaPath", "sourceRootRef", "configureArgs", "targets", "executables", "sourceFingerprint", "staticAssetFingerprints", "validationState", "validationErrors"]}]},
    "state": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["stateId", "kind", "slotName", "workerId", "runtimeEpoch", "fileRef", "sha256", "byteLength", "romIdentity", "romSha256", "frame", "stateLoadSerial", "fileTransactionSerial", "windowId", "rngSeed", "rngPosition", "partySummary", "enemySummary", "captureComplete", "serializable", "failureReason"]}]},
    "actionEvent": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["eventId", "eventOrdinal", "checkpoint", "windowId", "side", "actionId", "selector", "lookupId", "handlerAddress", "damage", "allyHpAfter", "enemyHpAfter", "status", "rngPositionAfter", "regions", "complete", "violation", "overflow"]}]},
    "rngCall": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["callOrdinal", "api", "entry", "complete", "incompleteReason", "caller", "arguments", "region", "seedBefore", "seedAfter", "advanceCount", "advances"]}]},
    "mismatch": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["mismatchId", "caseId", "eventOrdinal", "comparisonOrdinal", "field", "classification", "expected", "actual", "expectedEventRef", "actualEventRef", "rngFirstDifference", "stopOnFirstMismatchTriggered"]}]},
    "incident": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["incidentId", "caseId", "mismatchId", "commitState", "beforeStateId", "afterStateId", "failureStateId", "reproduceRef", "expectedRef", "actualRef", "staticContractRef", "rngCallsRef", "rngAgentSummaryRef", "unknownCallers", "classification", "firstDifference", "traceComplete", "overflow", "rerunId", "rerunWorkerId", "rerunAttempt", "debugRouteRef"]}]},
    "clionDebugRoute": {"allOf": [{"$ref": "#/$defs/common"}, {"type": "object", "required": ["routeId", "incidentId", "runConfiguration", "target", "executableRef", "arguments", "workingDirectory", "primaryBreakpoint", "secondarySymbols", "watches", "regionRoute", "launchPolicy"]}]},
    "prepare_test_runtimeRequest": {"type": "object", "required": ["laneCount", "buildProfile", "artifactRoot", "suiteBaseline", "forceReprepare"]},
    "run_casesRequest": {"type": "object", "required": ["runtimeId", "suite", "concurrency", "stopOnFirstMismatch", "incidentPolicy"]},
    "get_run_statusRequest": {"type": "object", "required": ["runId", "caseCursor", "caseLimit"]},
    "rerun_incidentRequest": {"type": "object", "required": ["incidentId", "traceMode", "laneHint", "priority"]},
    "stop_test_runtimeRequest": {"type": "object", "required": ["runtimeId", "mode", "graceMs"]}
  }
}
